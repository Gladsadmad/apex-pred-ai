{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./.test-build",
    "declaration": false,
    "declarationMap": false,
    // node --test treats every file under a directory named "test" as a test
    // file, so emitting .js.map siblings there would break discovery
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", ".test-build"]
}
